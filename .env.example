# Copy to .env. Fill these locally; never commit the completed file.
SPRING_PROFILES_ACTIVE=postgres
OMS_DB_URL=jdbc:postgresql://127.0.0.1:5432/internal_oms
OMS_DB_USERNAME=oms
OMS_DB_PASSWORD=
OMS_TOKEN_SECRET=
OMS_BOOTSTRAP_ADMIN_USERNAME=admin
OMS_BOOTSTRAP_ADMIN_NAME=系统管理员
OMS_BOOTSTRAP_ADMIN_PASSWORD=
OMS_UPLOAD_DIR=./uploads
OMS_DEV_API_ORIGIN=http://127.0.0.1:8081

# Optional external OCR. Both values are required for remote recognition.
ARK_API_KEY=
ARK_MODEL=

# Only needed for docker compose --profile extras
MINIO_ROOT_USER=omsadmin
MINIO_ROOT_PASSWORD=
